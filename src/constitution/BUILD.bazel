load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

cc_library(
    name = "uipc_constitution_lib",
    srcs = glob(["**/*.cpp"]),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.inl",
            "**/*.hpp",
        ],
        allow_empty = True,
    ),
    includes = ["."],
    local_defines = [
        "UIPC_CONSTITUTION_EXPORT_DLL=1",
    ],
    # Bake $ORIGIN so the wheel's flat uipc/_native/ layout resolves sibling .so.
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,-rpath,$$ORIGIN",
            "-Wl,-z,origin",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//:uipc_include",
        "//src/core:uipc_core_lib",
        "//src/geometry:uipc_geometry_lib",
    ],
)

cc_shared_library(
   name = "uipc_constitution_shared",
   shared_lib_name = "libuipc_constitution.so",
   visibility = ["//visibility:public"],
   deps = [
       ":uipc_constitution_lib",
   ],
   dynamic_deps = [
       "//src/geometry:uipc_geometry_shared",
       "//src/core:uipc_core_shared",
   ],
)
