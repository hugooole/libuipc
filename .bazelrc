common --enable_bzlmod
common --registry=https://raw.githubusercontent.com/hugooole/bazel-central-registry/dev
common --registry=https://bcr.bazel.build
common --cxxopt=-std=c++20

# The repo vendors third-party sources under external/ (METIS, GKlib), which
# collides with Bazel's reserved external-repo directory in the default layout.
# The sibling layout relocates external repos so our source external/ is visible.
common --experimental_sibling_repository_layout

build --flag_alias=cuda_archs=@rules_cuda//cuda:archs
build --cuda_archs=compute_89:compute_89,sm_89
build --jobs=16
build --compilation_mode=dbg
build --copt=-g
build --copt=-fno-omit-frame-pointer
build --copt=-fexceptions
build --strip=never
# Enable colorful output of GCC
build --cxxopt="-fdiagnostics-color=always"

# If a command fails, print out the full command line.
build --verbose_failures
# Work around the sandbox issue.
build --spawn_strategy=local

# ---------------------------------------------------------------------------
# Shared remote cache (bazel-remote), hosted on 192.168.10.81.
# Compilation still runs locally; results are shared through the cache server.
# ---------------------------------------------------------------------------
build --remote_cache=grpc://192.168.10.81:9092
# Upload our local build results so teammates can reuse them.
build --remote_upload_local_results=true
# If the cache server is unreachable, fall back to local execution instead of failing.
build --remote_local_fallback
# Don't let a slow/broken cache stall the build for long.
build --remote_timeout=60
# Also keep a local on-disk cache (fast rebuilds even when offline).
build --disk_cache=~/.cache/bazel-disk-cache

build:reldbg -c opt
build:reldbg --strip=never
build:reldbg --copt=-g
build:reldbg --copt=-fno-omit-frame-pointer

build:release -c opt
build:release --strip=always
build:release --copt=-O3
build:release --copt=-DNDEBUG
build:release --copt=-march=native
build:release --copt=-mtune=native
build:release --copt=-mfpmath=sse
build:release --copt=-msse4.2
build:release --copt=-msse4.1
build:release --copt=-msse4
build:release --copt=-msse3
build:release --copt=-msse2
build:release --copt=-msse